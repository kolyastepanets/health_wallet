<div class="lab-import-detail">
  <div class="lab-import-header">
    <%= link_to "← Back to Imports", lab_imports_path, class: "back-link" %>
    <h1>Import Lab Results</h1>
  </div>

  <% if alert %>
    <div class="flash-alert"><%= alert %></div>
  <% end %>

  <p class="lab-import-hint">
    Upload one or more laboratory result files in the simplified HL7 format.
    Each file is processed in the background; you can follow its status on the imports page.
  </p>

  <%= form_with url: lab_imports_path, method: :post, multipart: true, class: "lab-import-form" do %>
    <div class="form-field">
      <%= label_tag "files", "Result files" %>
      <%= file_field_tag "files[]", multiple: true, accept: ".txt,.hl7,text/plain" %>
    </div>

    <div class="form-actions">
      <%= link_to "Cancel", lab_imports_path, class: "btn btn-secondary" %>
      <%= submit_tag "Upload", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
